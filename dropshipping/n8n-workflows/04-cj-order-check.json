    {
      "parameters": {
        "url": "https://developers.cjdropshipping.com/api2.0/v1/shopping/order/list",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pageNum",
              "value": "1"
            },
            {
              "name": "pageSize",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "CJ-Access-Token",
              "value": "={{ $('CJ: get token').first().json.data.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "59d90459-ea83-5682-8e0f-fa0b7d328e40",
      "name": "CJ: recent orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('⚙️ Settings').first().json;\nconst res = $('CJ: recent orders').first().json;\nif (res.code !== 200) throw new Error('CJ order list failed: ' + (res.message || JSON.stringify(res).slice(0, 300)));\nconst list = res.data?.list || [];\nconst now = Date.now();\nconst age = d => d ? (now - Date.parse(String(d).replace(' ', 'T') + 'Z')) / 3600e3 : 0;\nconst unpaid = list.filter(o => ['CREATED', 'IN_CART', 'UNPAID'].includes(o.orderStatus));\nconst late = list.filter(o => o.paymentDate && !o.trackNumber\n  && ['PENDING', 'PROCESSING', 'UNSHIPPED'].includes(o.orderStatus) && age(o.paymentDate) > s.late_hours);\nif (!unpaid.length && !late.length) return [];\n\nconst parts = [];\nif (unpaid.length) parts.push(`💳 ${unpaid.length} CJ order(s) waiting for you to pay:\\n`\n  + unpaid.map(o => `- ${o.orderNum}${o.orderAmount ? ' ($' + o.orderAmount + ')' : ''}`).join('\\n')\n  + '\\nOpen CJ -> My Orders and pay them.');\nif (late.length) parts.push(`⏰ ${late.length} paid order(s) have no tracking after ${s.late_hours}h:\\n`\n  + late.map(o => `- ${o.orderNum} (paid ${o.paymentDate})`).join('\\n')\n  + '\\nOpen a ticket with your CJ agent and email the customer an honest update.');\nreturn [{ json: { text: parts.join('\\n\\n').slice(0, 4000) } }];\n"
      },
      "id": "ecaa734f-20c3-5aab-87ed-538456568828",
      "name": "Find problems",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
