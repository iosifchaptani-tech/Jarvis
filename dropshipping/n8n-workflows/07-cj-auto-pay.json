      "id": "84473c9a-8fec-5a90-a33a-d14a976f2d6c",
      "name": "CJ: wallet balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        0
      ],
      "executeOnce": true,
      "onError": "continueRegularOutput"
