		Size = { { 0, 0 }, { 0.35, 0.5 }, { 1, 0 } }, Transparency = { { 0, 0.6 }, { 0.35, 0 }, { 1, 1 } },
		Light = 1, Rotation = { 0, 360 }, RotSpeed = { -40, 40 },
		Shape = "Sphere", Style = "Volume", HostScale = 1.45,
