		Size = { { 0, 0.3 }, { 0.5, 0.42 }, { 1, 0 } }, Transparency = { { 0, 0.1 }, { 1, 1 } },
		Light = 1, Rotation = { 0, 360 }, RotSpeed = { -90, 90 }, Accel = Vector3.new(0, 0.6, 0), Drag = 1,
		Shape = "Sphere", Style = "Volume", HostScale = 1.15,
	},
