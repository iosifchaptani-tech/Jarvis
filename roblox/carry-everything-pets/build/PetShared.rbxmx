		Size = { { 0, 0.14 }, { 1, 0.04 } }, Transparency = { { 0, 0 }, { 0.7, 0.2 }, { 1, 1 } },
		Light = 1, Accel = Vector3.new(0, 1, 0), Drag = 0.5,
		Shape = "Box", Style = "Volume",
	},
	Pillar = {
		Texture = "Sparkle", Lifetime = { 1.0, 1.6 }, Speed = { 2.5, 4.5 }, Spread = 4,
