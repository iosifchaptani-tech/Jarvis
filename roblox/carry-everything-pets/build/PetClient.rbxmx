<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="LocalScript" referent="RBX81FBB586B0159025AFE5C8A0085F43CA">
		<Properties>
			<string name="Name">PetClient</string>
			<ProtectedString name="Source"><![CDATA[--[[
	PetClient  (StarterPlayer > StarterPlayerScripts > PetClient, a LocalScript)

	Runs on each player's device. Its ModuleScript children do the work:
	  PetRenderer    draws and moves every player's pets
	  PetUI          the PETS button, the Pets menu and the egg panel
	  HatchCutscene  the egg opening animation
	  UIKit          shared look of the menus
]]

local PetRenderer = require(script:WaitForChild("PetRenderer"))
local PetUI = require(script:WaitForChild("PetUI"))
local HatchCutscene = require(script:WaitForChild("HatchCutscene"))

PetRenderer.Start()
PetUI.Start({ Renderer = PetRenderer, Cutscene = HatchCutscene })
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBXCDC973FBDD816DFAAADA7515C9A067D5">
			<Properties>
				<string name="Name">HatchCutscene</string>
				<ProtectedString name="Source"><![CDATA[--[[
	HatchCutscene  (StarterPlayerScripts > PetClient > HatchCutscene, a ModuleScript)

	The egg opening: the egg pops up, shakes three times (harder each time),
	a white flash, then each new pet appears in front of spinning light rays in its
	rarity color with its name, rarity, power and a "NEW!" tag for first finds.
	Tap anywhere (or wait a few seconds) to continue. Works for 1 or 3 eggs.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("PetShared")
local PetConfig = require(Shared:WaitForChild("PetConfig"))
local PetBuilder = require(Shared:WaitForChild("PetBuilder"))
local PetLogic = require(Shared:WaitForChild("PetLogic"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local HatchCutscene = {}

local STAGE_W, STAGE_H = 780, 380

local function rays(parent: Instance, rarityName: string): Frame
	local holder = UIKit.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(120, 110),
		Size = UDim2.fromOffset(320, 320),
		Parent = parent,
	})
	local rarity = PetConfig.Rarities[rarityName]
	local base = if rarity then rarity.Color else Color3.new(1, 1, 1)
	local gradient = rarity and rarity.Gradient
	for i = 0, 11 do
		local color = base
		if gradient then
			color = gradient[(i % #gradient) + 1]
		end
		local bar = UIKit.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 22, 1, 0),
			Rotation = i * 15,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.35,
			Parent = holder,
		})
		UIKit.make("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = bar,
		})
	end
	local glow = UIKit.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(170, 170),
		BackgroundColor3 = base,
		BackgroundTransparency = 0.7,
		Parent = holder,
	})
	UIKit.corner(glow, 0, 0.5)
	return holder
end

-- Plays the animation and returns when the player taps (or after a few seconds).
function HatchCutscene.Play(eggId: string, results: { any }, playerGui: Instance)
	local gui = UIKit.make("ScreenGui", {
		Name = "PetHatch",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local dim = UIKit.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 4, 14), BackgroundTransparency = 1, Parent = gui })
	UIKit.tween(dim, 0.25, { BackgroundTransparency = 0.12 })

	local stage = UIKit.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(STAGE_W, STAGE_H),
		Parent = gui,
	})
	UIKit.autoScale(stage, gui, STAGE_W + 40, STAGE_H + 20, 0.45, 1.5)

	-- 1. the egg pops up and shakes
	local eggView = UIKit.viewport({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(STAGE_W / 2, STAGE_H / 2 - 10),
		Size = UDim2.fromOffset(10, 10),
		Parent = stage,
	})
	UIKit.show(eggView, PetBuilder.BuildEgg(eggId, 1), 200, 10, 0.8)
	UIKit.tween(eggView, 0.35, { Size = UDim2.fromOffset(250, 250) }, Enum.EasingStyle.Back)
	task.wait(0.45)
	for round = 1, 3 do
		local amount = 6 * round
		for _ = 1, 2 do
			UIKit.tween(eggView, 0.06, { Rotation = amount })
			task.wait(0.06)
			UIKit.tween(eggView, 0.06, { Rotation = -amount })
			task.wait(0.06)
		end
		UIKit.tween(eggView, 0.06, { Rotation = 0 })
		task.wait(0.22)
	end

	-- 2. flash
	local flash = UIKit.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 20, Parent = gui })
	eggView:Destroy()
	UIKit.tween(flash, 0.45, { BackgroundTransparency = 1 })

	-- 3. the pets
	local count = #results
	local slotW = 240
	local gap = 20
	local startX = (STAGE_W - (count * slotW + (count - 1) * gap)) / 2
	local spinning = {}
	local rayFrames = {}
	if count == 1 then
		UIKit.text({ Text = "YOU HATCHED", Position = UDim2.fromOffset(0, -6), Size = UDim2.fromOffset(STAGE_W, 28), TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 230), Parent = stage })
	end
	for i, result in ipairs(results) do
		local def = PetConfig.Pets[result.Pet]
		if def then
			local slot = UIKit.frame({ Position = UDim2.fromOffset(startX + (i - 1) * (slotW + gap), 24), Size = UDim2.fromOffset(slotW, 340), Parent = stage })
			local pop = UIKit.make("UIScale", { Scale = 0, Parent = slot })
			table.insert(rayFrames, rays(slot, def.Rarity))
			local view = UIKit.viewport({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(120, 110), Size = UDim2.fromOffset(220, 220), Parent = slot })
			UIKit.show(view, PetBuilder.Build(result.Pet, { Fx = false, Scale = 1 }).Model, 215, 16, 0.9)
			table.insert(spinning, view)
			UIKit.text({ Text = def.Name, Position = UDim2.fromOffset(0, 226), Size = UDim2.fromOffset(slotW, 36), TextSize = 30, TextScaled = true, Parent = slot })
			local rarityLabel = UIKit.text({
				Text = string.upper(def.Rarity) .. "  " .. PetLogic.FormatPower(def.Power) .. " POWER",
				Position = UDim2.fromOffset(0, 262),
				Size = UDim2.fromOffset(slotW, 22),
				TextSize = 18,
				Parent = slot,
			})
			UIKit.applyRarity(rarityLabel, def.Rarity)
			if result.New then
				local tag = UIKit.text({
					Text = "NEW!",
					Position = UDim2.fromOffset(slotW - 84, 14),
					Size = UDim2.fromOffset(70, 32),
					Rotation = 10,
					BackgroundColor3 = Color3.fromRGB(255, 225, 77),
					BackgroundTransparency = 0,
					TextColor3 = Color3.fromRGB(42, 26, 0),
					TextSize = 20,
					Parent = slot,
				})
				UIKit.corner(tag, 10)
				UIKit.stroke(tag, Color3.new(1, 1, 1), 3)
			end
			UIKit.tween(pop, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			task.wait(0.12)
		end
	end
	UIKit.text({
		Text = "Tap anywhere to continue",
		Position = UDim2.fromOffset(0, STAGE_H - 4),
		Size = UDim2.fromOffset(STAGE_W, 22),
		Font = UIKit.BodyFont,
		TextSize = 15,
		TextColor3 = Color3.fromRGB(185, 176, 201),
		Parent = stage,
	})

	local yaw = 215
	local connection = RunService.RenderStepped:Connect(function(dt)
		yaw += dt * 50
		for _, view in ipairs(spinning) do
			UIKit.orbit(view, yaw)
		end
		for _, frame in ipairs(rayFrames) do
			frame.Rotation += dt * 25
		end
	end)

	local done = false
	local catcher = UIKit.make("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 30,
		Parent = gui,
	})
	catcher.Activated:Connect(function()
		done = true
	end)
	local began = os.clock()
	task.wait(0.4)
	while not done and os.clock() - began < 6.5 do
		task.wait(0.05)
	end

	UIKit.tween(dim, 0.25, { BackgroundTransparency = 1 })
	UIKit.tween(stage, 0.25, { Position = UDim2.new(0.5, 0, 0.5, 40) })
	task.wait(0.27)
	connection:Disconnect()
	gui:Destroy()
end

return HatchCutscene
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXD3CD076FE83C06D97BE127CFB901CB60">
			<Properties>
				<string name="Name">PetRenderer</string>
				<ProtectedString name="Source"><![CDATA[--[[
	PetRenderer  (StarterPlayerScripts > PetClient > PetRenderer, a ModuleScript)

	Draws EVERY player's equipped pets on this device:
	  - reads the "PetsEquipped" and "PetFormation" attributes the server puts on each player
	  - builds the pets locally (nothing is sent over the network every frame, so it is smooth)
	  - flies them behind their owner in a formation, with floating, banking and wing flaps
	  - saves work far away: fewer particles, then no particles, then the pet hides
	  - limits the neon outlines to what Roblox can show (31 at once)
	Also gently spins and bobs the eggs on their stands.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("PetShared")
local PetConfig = require(Shared:WaitForChild("PetConfig"))
local PetBuilder = require(Shared:WaitForChild("PetBuilder"))
local PetLogic = require(Shared:WaitForChild("PetLogic"))

local Renderer = {}
Renderer.FxChanged = Instance.new("BindableEvent")

local localPlayer = Players.LocalPlayer
local container: Folder? = nil
local owners: { [Player]: any } = {}
local fxSetting = "High"
local eggs: { [Instance]: any } = {}
local started = false

local GROUND_BELOW_ROOT = 3 -- studs from a character's HumanoidRootPart down to its feet

local function isPhoneOrTablet(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function lowQualityDevice(): boolean
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel
	end)
	if ok and level and level ~= Enum.SavedQualitySetting.Automatic then
		return level.Value <= 3
	end
	return false
end

---------------------------------------------------------------------
-- Effects setting ("High", "Low", "Off")
---------------------------------------------------------------------

function Renderer.GetFxSetting(): string
	return fxSetting
end

local lodNow -- set below

function Renderer.SetFxSetting(setting: string)
	if setting ~= "High" and setting ~= "Low" and setting ~= "Off" then
		return
	end
	fxSetting = setting
	Renderer.FxChanged:Fire(setting)
	if lodNow then
		lodNow()
	end
end

---------------------------------------------------------------------
-- Owners and their pets
---------------------------------------------------------------------

local function setVisible(entry, visible: boolean)
	if entry.Visible == visible then
		return
	end
	entry.Visible = visible
	if visible then
		if entry.CF then
			entry.Pet:SetCFrame(entry.CF)
		end
		entry.Pet.Model.Parent = container
		if entry.New then
			entry.New = false
			entry.Pet:Poof()
		end
	else
		entry.Pet:SetOutline(false)
		entry.Pet.Model.Parent = nil
	end
end

local function parseEquipped(value: any): { string }
	local list = {}
	if type(value) ~= "string" then
		return list
	end
	for petId in string.gmatch(value, "[^,]+") do
		if PetConfig.Pets[petId] then
			table.insert(list, petId)
		end
	end
	return list
end

local function syncOwner(player: Player, owner)
	local wanted = parseEquipped(player:GetAttribute("PetsEquipped"))
	owner.Formation = player:GetAttribute("PetFormation") or PetConfig.DefaultFormation

	local pool = {}
	for _, entry in ipairs(owner.Pets) do
		pool[entry.Id] = pool[entry.Id] or {}
		table.insert(pool[entry.Id], entry)
	end
	local list = {}
	for _, petId in ipairs(wanted) do
		local bucket = pool[petId]
		if bucket and #bucket > 0 then
			table.insert(list, table.remove(bucket, 1))
		else
			local ok, pet = pcall(PetBuilder.Build, petId)
			if ok then
				table.insert(list, { Id = petId, Pet = pet, Visible = false, New = true, Yaw = 0 })
			else
				warn("[Pets] Could not build " .. petId .. ": " .. tostring(pet))
			end
		end
	end
	for _, bucket in pairs(pool) do
		for _, entry in ipairs(bucket) do
			entry.Pet:Destroy()
		end
	end
	owner.Pets = list

	local spacing = 1
	for _, entry in ipairs(list) do
		spacing = math.max(spacing, entry.Pet.Radius * 1.6)
	end
	owner.Spacing = spacing
	if lodNow then
		lodNow()
	end
end

local function track(player: Player)
	if owners[player] then
		return
	end
	local owner = { Player = player, Pets = {}, Formation = PetConfig.DefaultFormation, Spacing = 1, Connections = {} }
	owners[player] = owner
	table.insert(owner.Connections, player:GetAttributeChangedSignal("PetsEquipped"):Connect(function()
		syncOwner(player, owner)
	end))
	table.insert(owner.Connections, player:GetAttributeChangedSignal("PetFormation"):Connect(function()
		owner.Formation = player:GetAttribute("PetFormation") or PetConfig.DefaultFormation
	end))
	syncOwner(player, owner)
end

local function untrack(player: Player)
	local owner = owners[player]
	if not owner then
		return
	end
	owners[player] = nil
	for _, connection in ipairs(owner.Connections) do
		connection:Disconnect()
	end
	for _, entry in ipairs(owner.Pets) do
		entry.Pet:Destroy()
	end
end

---------------------------------------------------------------------
-- Every frame: follow and animate
---------------------------------------------------------------------

local function update(dt: number)
	dt = math.min(dt, 0.1)
	local t = os.clock()
	local follow = 1 - math.exp(-dt * PetConfig.FollowSmoothness)
	local turn = 1 - math.exp(-dt * 7)

	for player, owner in pairs(owners) do
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not rootPart then
			for _, entry in ipairs(owner.Pets) do
				entry.NoOwner = true
				setVisible(entry, false)
				entry.Pos = nil
			end
			continue
		end

		local rootCF = rootPart.CFrame
		local look = Vector3.new(rootCF.LookVector.X, 0, rootCF.LookVector.Z)
		if look.Magnitude < 0.01 then
			look = Vector3.new(0, 0, -1)
		end
		look = look.Unit
		local base = CFrame.lookAt(rootCF.Position, rootCF.Position + look)
		local velocity = rootPart.AssemblyLinearVelocity
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		local speed = flat.Magnitude
		local facing = if speed > 2 then flat.Unit else look
		local targetYaw = math.atan2(-facing.X, -facing.Z)
		local groundY = rootCF.Position.Y - GROUND_BELOW_ROOT
		local slots = PetLogic.FormationSlots(owner.Formation, #owner.Pets, owner.Spacing, t)
		local pitch = -math.clamp(speed / 22, 0, 1) * math.rad(14)

		for i, entry in ipairs(owner.Pets) do
			entry.NoOwner = false
			local slot = slots[i]
			local pet = entry.Pet
			local spot = base * Vector3.new(slot[1], 0, slot[3])
			local bob = math.sin(t * 2 + pet.Phase) * 0.3
			local target = Vector3.new(spot.X, groundY + 1.2 + PetConfig.FloatHeight + slot[2] - pet.Bottom + bob, spot.Z)
			if not entry.Pos or (entry.Pos - target).Magnitude > 60 then
				entry.Pos = target
				entry.Yaw = targetYaw
			end
			local previous = entry.Pos
			entry.Pos = previous:Lerp(target, follow)
			entry.Yaw = PetLogic.LerpAngle(entry.Yaw, targetYaw, turn)
			-- bank into turns: compare where the pet is going with where it faces
			local move = entry.Pos - previous
			local right = Vector3.new(math.cos(entry.Yaw), 0, -math.sin(entry.Yaw))
			local roll = math.clamp(-move:Dot(right) / math.max(dt, 1e-3) * 0.02, -0.35, 0.35)
			entry.Roll = (entry.Roll or 0) + (roll - (entry.Roll or 0)) * turn
			entry.CF = CFrame.new(entry.Pos) * CFrame.Angles(0, entry.Yaw, 0) * CFrame.Angles(pitch, 0, entry.Roll)
			if entry.Visible then
				pet:SetCFrame(entry.CF)
				pet:Animate(t, dt, speed, entry.Detailed == true)
			end
		end
	end

	-- eggs on their stands: slow spin and bob (only near the camera)
	local camera = Workspace.CurrentCamera
	if camera then
		local camPos = camera.CFrame.Position
		for _, egg in pairs(eggs) do
			if egg.Model.Parent and (egg.Base.Position - camPos).Magnitude < 140 then
				egg.Model:PivotTo(egg.Base * CFrame.new(0, math.sin(t * 1.6) * 0.3, 0) * CFrame.Angles(0, t * 0.7, 0))
			end
		end
	end
end

---------------------------------------------------------------------
-- A few times a second: what to show, how much effects, which outlines
---------------------------------------------------------------------

local function lod()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local fx = PetConfig.Fx
	local list = {}
	for player, owner in pairs(owners) do
		local mine = player == localPlayer
		for _, entry in ipairs(owner.Pets) do
			if entry.Pos and not entry.NoOwner then
				table.insert(list, { Entry = entry, Distance = (entry.Pos - camPos).Magnitude, Mine = mine })
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Mine ~= b.Mine then
			return a.Mine
		end
		return a.Distance < b.Distance
	end)

	local particleSlots = fx.MaxParticlePets
	local outlines = fx.OutlineBudget
	local baseRate = if fxSetting == "High" then 1 elseif fxSetting == "Low" then fx.LowRate else 0
	for _, item in ipairs(list) do
		local entry, distance = item.Entry, item.Distance
		local visible = distance < fx.HideDistance
		setVisible(entry, visible)
		if visible then
			local level
			if fxSetting == "Off" or distance > fx.RingDistance then
				level = 0
			elseif distance > fx.ParticleDistance or particleSlots <= 0 then
				level = 1
			else
				level = 2
				particleSlots -= 1
			end
			local rate = baseRate * (if item.Mine then 1 else fx.OtherPlayersRate)
			entry.Pet:SetFx(level, rate)
			entry.Detailed = distance < fx.RingDistance
			local outline = outlines > 0 and distance < fx.RingDistance
			if outline then
				outlines -= 1
			end
			entry.Pet:SetOutline(outline)
		end
	end
end
lodNow = lod

---------------------------------------------------------------------
-- Eggs
---------------------------------------------------------------------

local function addEgg(stand: Instance)
	if eggs[stand] then
		return
	end
	local model = stand:WaitForChild("Egg", 10)
	if model and model:IsA("Model") then
		eggs[stand] = { Model = model, Base = model:GetPivot() }
	end
end

local function removeEgg(stand: Instance)
	eggs[stand] = nil
end

---------------------------------------------------------------------
-- Start
---------------------------------------------------------------------

function Renderer.Start()
	if started then
		return
	end
	started = true

	if (PetConfig.Fx.PhonesStartLow and isPhoneOrTablet()) or lowQualityDevice() then
		fxSetting = "Low"
	end

	local folder = Instance.new("Folder")
	folder.Name = "LocalPets"
	folder.Parent = Workspace
	container = folder

	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)

	for _, stand in ipairs(CollectionService:GetTagged("PetEggStand")) do
		task.spawn(addEgg, stand)
	end
	CollectionService:GetInstanceAddedSignal("PetEggStand"):Connect(addEgg)
	CollectionService:GetInstanceRemovedSignal("PetEggStand"):Connect(removeEgg)

	RunService.RenderStepped:Connect(update)
	task.spawn(function()
		while true do
			lod()
			task.wait(0.25)
		end
	end)
end

return Renderer
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX1041B31836A7214247AA9B2FD07D9161">
			<Properties>
				<string name="Name">PetUI</string>
				<ProtectedString name="Source"><![CDATA[--[[
	PetUI  (StarterPlayerScripts > PetClient > PetUI, a ModuleScript)

	All pet menus, built in code (nothing to place by hand):
	  - the orange PETS button on the left with the equipped count and the multiplier
	  - the Pets menu: every pet as a card (unfound pets are dark "?" cards), a turning
	    3D picture of the chosen pet, Equip / Unequip / Delete, Equip Best, Unequip All,
	    Formation (Arc / Circle / V) and Effects (High / Low / Off)
	  - the egg panel that opens at an egg: odds of every pet, Open 1, Open 3
	  - short messages at the top ("Not enough Coins", "X hatched a Mythic ...")
	Sized for a phone held sideways (buttons at least 44 px) and scaled up on bigger screens.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("PetShared")
local PetConfig = require(Shared:WaitForChild("PetConfig"))
local PetBuilder = require(Shared:WaitForChild("PetBuilder"))
local PetLogic = require(Shared:WaitForChild("PetLogic"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local C = UIKit.C
local WHITE = Color3.new(1, 1, 1)
local SILHOUETTE = Color3.fromRGB(8, 10, 22)

local PetUI = {}

local player = Players.LocalPlayer
local remotes: any = nil
local Renderer: any = nil
local Cutscene: any = nil
local gui: ScreenGui = nil :: any
local data: any = nil
local selected = PetConfig.PetOrder[1]
local deleteArmed: string? = nil
local busy = false
local currentEgg: any = nil
local ui: any = { Cards = {}, EggTiles = {} }

---------------------------------------------------------------------
-- Talking to the server
---------------------------------------------------------------------

local function request(action: string, arg: any): (boolean, any)
	local ok, success, result = pcall(function()
		return remotes.Request:InvokeServer(action, arg)
	end)
	if not ok then
		return false, "Connection problem, please try again"
	end
	return success == true, result
end

local function escape(text: string): string
	text = string.gsub(text, "&", "&amp;")
	text = string.gsub(text, "<", "&lt;")
	text = string.gsub(text, ">", "&gt;")
	return text
end

---------------------------------------------------------------------
-- Messages at the top of the screen
---------------------------------------------------------------------

local function toast(text: string, color: Color3?)
	if not ui.Toasts then
		return
	end
	local item = UIKit.text({
		Text = text,
		RichText = true,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		TextSize = 18,
		TextColor3 = color or C.Text,
		Parent = ui.Toasts,
	})
	UIKit.corner(item, 12)
	UIKit.make("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = item })
	local stroke = UIKit.stroke(item, C.Border, 2)
	task.delay(3, function()
		UIKit.tween(item, 0.35, { TextTransparency = 1, BackgroundTransparency = 1 })
		UIKit.tween(stroke, 0.35, { Transparency = 1 })
		task.wait(0.4)
		item:Destroy()
	end)
end

---------------------------------------------------------------------
-- Small lookups
---------------------------------------------------------------------

local function counts(petId: string): (number, number, boolean)
	if not data then
		return 0, 0, false
	end
	local owned = data.Counts[petId] or 0
	local equipped = data.Equipped[petId] or 0
	local known = owned > 0 or data.Discovered[petId] == true
	return owned, equipped, known
end

local function whereToFind(petId: string): string
	local found = {}
	for _, eggId in ipairs(PetConfig.EggOrder) do
		local egg = PetConfig.Eggs[eggId]
		for _, entry in ipairs(egg.Odds) do
			if entry[1] == petId then
				table.insert(found, egg.Name .. " " .. PetLogic.FormatPercent(entry[2]))
			end
		end
	end
	if #found == 0 then
		return "Game pass pet"
	end
	return "Found in " .. table.concat(found, ", ")
end

local function currencyValue(): any
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		return nil
	end
	local value = stats:FindFirstChild(PetConfig.CurrencyName)
	if value then
		return value
	end
	for _, name in ipairs(PetConfig.CurrencyFallbacks) do
		value = stats:FindFirstChild(name)
		if value then
			return value
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Refresh (called whenever the data changes)
---------------------------------------------------------------------

local function refreshDetail()
	local def = PetConfig.Pets[selected]
	if not def or not ui.DetailName then
		return
	end
	local owned, equipped, known = counts(selected)
	if ui.DetailPet ~= selected then
		ui.DetailPet = selected
		local pet = PetBuilder.Build(selected, { Fx = false, Scale = 1 })
		UIKit.show(ui.DetailViewport, pet.Model, 215, 18, 0.95)
	end
	ui.DetailViewport.ImageColor3 = if known then WHITE else SILHOUETTE
	ui.DetailName.Text = if known then def.Name else "???"
	ui.DetailRarity.Text = string.upper(def.Rarity) .. "  " .. PetLogic.FormatPower(def.Power)
	UIKit.applyRarity(ui.DetailRarity, def.Rarity)
	if owned > 0 then
		ui.DetailInfo.Text = ("Owned %d · Equipped %d"):format(owned, equipped)
	else
		ui.DetailInfo.Text = whereToFind(selected)
	end

	local rarity = PetConfig.Rarities[def.Rarity]
	local passFor = if def.Rarity == "Exclusive" then "CrystalKing" else nil
	local canBuy = owned == 0 and passFor ~= nil and (PetConfig.GamePasses[passFor] or 0) ~= 0
	ui.EquipButton.Visible = owned > 0 or canBuy
	ui.EquipButton.Text = if canBuy then "Get it" else "Equip"
	local free = data and data.EquippedTotal < data.MaxEquip
	ui.EquipButton.BackgroundColor3 = if canBuy or (equipped < owned and free) then C.GreenBright else C.Grey
	ui.UnequipButton.Visible = owned > 0
	ui.UnequipButton.BackgroundColor3 = if equipped > 0 then C.Blue else C.Grey
	ui.DeleteButton.Visible = owned > 0 and not (rarity and rarity.NoDelete)
	ui.DeleteButton.BackgroundColor3 = if deleteArmed == selected then C.RedBright else C.DarkRed
	ui.DeleteSure.Visible = deleteArmed == selected
	ui.DeleteIcon.Visible = deleteArmed ~= selected
end

local function refresh()
	if not data then
		return
	end
	local equippedText = ("%d/%d"):format(data.EquippedTotal, data.MaxEquip)
	local multiplierText = PetLogic.FormatMultiplier(data.Multiplier)
	ui.Badge.Text = equippedText
	ui.HudMultiplier.Text = multiplierText
	ui.EquippedChip.Text = "Equipped " .. equippedText
	ui.MultiplierChip.Text = multiplierText
	ui.Storage.Text = ("Storage %d/%d"):format(data.Storage, data.MaxStorage)
	ui.FormationButton.Text = "Formation: " .. tostring(data.Formation)
	ui.EffectsButton.Text = "Effects: " .. Renderer.GetFxSetting()

	for petId, card in pairs(ui.Cards) do
		local def = PetConfig.Pets[petId]
		local owned, equipped, known = counts(petId)
		card.Viewport.ImageColor3 = if known then WHITE else SILHOUETTE
		card.Viewport.ImageTransparency = if known and owned == 0 then 0.55 else 0
		card.Name.Text = if known then def.Name else "???"
		card.Name.TextColor3 = if known then C.Text else C.Unknown
		card.Question.Visible = not known
		card.Count.Visible = known and owned ~= 1
		card.Count.Text = "x" .. owned
		card.Equipped.Visible = equipped > 0
		card.Equipped.Text = if equipped > 1 then "E" .. equipped else "E"
		card.Bar.BackgroundColor3 = if known then UIKit.rarityColor(def.Rarity) else C.Unknown
		local isSelected = petId == selected
		card.Stroke.Color = if isSelected then WHITE else C.CardBorder
		card.Stroke.Thickness = if isSelected then 3 else 2
	end
	refreshDetail()

	if currentEgg and ui.EggBalance then
		local value = currencyValue()
		ui.EggBalance.Text = if value then ("You have %s %s"):format(PetLogic.FormatNumber(value.Value), PetConfig.CurrencyName) else ""
	end
end

local function select(petId: string)
	if selected ~= petId then
		deleteArmed = nil
	end
	selected = petId
	refresh()
end

---------------------------------------------------------------------
-- Opening and closing
---------------------------------------------------------------------

local function closeInventory()
	if ui.Inventory and ui.Inventory.Visible then
		ui.Inventory.Visible = false
		deleteArmed = nil
	end
end

local function openInventory()
	if busy then
		return
	end
	if ui.EggPanel then
		ui.EggPanel.Visible = false
		currentEgg = nil
	end
	ui.Inventory.Position = UDim2.new(0.5, 0, 0.5, 26)
	ui.Inventory.Visible = true
	UIKit.tween(ui.Inventory, 0.22, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	refresh()
end

local function toggleInventory()
	if ui.Inventory.Visible then
		closeInventory()
	else
		openInventory()
	end
end

local function closeEgg()
	currentEgg = nil
	if ui.EggPanel then
		ui.EggPanel.Visible = false
	end
end

---------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------

local function act(action: string, arg: any)
	local ok, message = request(action, arg)
	if not ok then
		toast(tostring(message or "Something went wrong"), C.RedBright)
	end
	return ok
end

local function onEquip()
	local def = PetConfig.Pets[selected]
	local owned = counts(selected)
	if owned == 0 and def and def.Rarity == "Exclusive" then
		act("BuyPass", "CrystalKing")
		return
	end
	act("Equip", selected)
end

local function onDelete()
	if deleteArmed ~= selected then
		deleteArmed = selected
		refreshDetail()
		local armedFor = selected
		task.delay(2.5, function()
			if deleteArmed == armedFor then
				deleteArmed = nil
				refreshDetail()
			end
		end)
		return
	end
	deleteArmed = nil
	act("Delete", selected)
end

local function onFormation()
	local list = PetConfig.Formations
	local index = table.find(list, data and data.Formation or list[1]) or 1
	act("SetFormation", list[index % #list + 1])
end

local function onEffects()
	local order = { "High", "Low", "Off" }
	local index = table.find(order, Renderer.GetFxSetting()) or 1
	Renderer.SetFxSetting(order[index % #order + 1])
	refresh()
end

local function hatch(count: number)
	if busy or not currentEgg then
		return
	end
	if count == 3 and data and not data.TripleHatch then
		act("BuyPass", "TripleHatch")
		return
	end
	busy = true
	local eggId = currentEgg.Id
	local ok, result = request(if count == 3 then "Hatch3" else "Hatch", eggId)
	if not ok then
		busy = false
		toast(tostring(result), C.RedBright)
		return
	end
	ui.EggPanel.Visible = false
	closeInventory()
	local played = pcall(Cutscene.Play, eggId, result.Results, gui.Parent)
	if not played then
		for _, r in ipairs(result.Results) do
			toast("You got " .. PetConfig.Pets[r.Pet].Name .. "!")
		end
	end
	busy = false
	if currentEgg then
		ui.EggPanel.Visible = true
		refresh()
	end
end

